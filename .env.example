GAME_ART_STYLE_PROVIDER_BASE_URL=
GAME_ART_STYLE_PROVIDER_API_KEY=
GAME_ART_STYLE_PROVIDER_MODEL=
GAME_ART_STYLE_DOWNLOAD_HOSTS=

# Stripe Checkout (avatar → Billing)
# Local: set in .env.local. Production/Preview: set these in the Vercel
# environment or as GitHub Actions secrets so deploy-vercel.yml can sync them.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional override for the 1,000-credit pack amount (cents), useful in test mode
STRIPE_CHECKOUT_AMOUNT_CENTS=
# Public site origin used for Stripe success/cancel redirects (e.g. https://app.example.com)
NEXT_PUBLIC_SITE_URL=
