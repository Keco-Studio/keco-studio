    "test:e2e:pr": "playwright test tests/e2e/specs/agent-chat.spec.ts tests/e2e/specs/table-export-filter-navigation.spec.ts tests/e2e/specs/global-search.spec.ts tests/e2e/specs/library-table-document-copy.spec.ts tests/e2e/specs/concurrent-editing.spec.ts tests/e2e/specs/conversation-player.spec.ts tests/e2e/specs/documents.spec.ts tests/e2e/specs/document-phase2.spec.ts tests/e2e/specs/document-collaboration.spec.ts tests/e2e/specs/document-version-history.spec.ts tests/e2e/specs/document-references.spec.ts tests/e2e/specs/document-derived-libraries.spec.ts tests/e2e/specs/simulation-system.spec.ts",
    "test:unit:pr": "jest --runInBand tests/unit/api-export-route.test.ts tests/unit/column-value-filter.test.ts tests/unit/cell-navigation.test.ts src/components/libraries/components/scriptPlayer.test.ts tests/unit/table-scalability-static.test.ts tests/unit/realtime-conflict-resolution.test.ts tests/unit/agent/abort-core-wiring.test.ts tests/unit/agent/sse-abort.test.ts tests/unit/agent/agent-panel-header.test.tsx tests/unit/agent/assistant-message.test.tsx tests/unit/agent/assistant-stream-items.test.ts tests/unit/agent/conversation-switch-lifecycle-wiring.test.ts tests/unit/agent/document-confirmation-ui.test.tsx tests/unit/agent/embedding-client.test.ts tests/unit/agent/insert-resource-reference.test.ts tests/unit/agent/llm-client-retry.test.ts tests/unit/agent/outbound-http.test.ts tests/unit/agent/system-prompt.test.ts tests/unit/simulation/mapping-layout.test.ts tests/unit/simulation/workbench-flow.test.tsx",
    "test:pr": "npm run test:unit:pr && npm run test:e2e:pr",
    "test:unit": "jest",
    "test:mcp": "deno test --config supabase/functions/mcp/deno.json --allow-env --allow-net supabase/functions/mcp",
