{
  "name": "keco-studio",
  "version": "0.3.1",
  "private": true,
  "dependencies": {
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/koulen": "^5.2.7",
    "@fontsource/nunito": "^5.2.7",
    "@fontsource/roboto": "^5.2.10",
    "@react-email/components": "^1.0.4",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "2.87.1",
    "@tanstack/react-query": "^5.90.16",
    "@tanstack/react-virtual": "^3.14.6",
    "antd": "^5.22.2",
    "exceljs": "^4.4.0",
    "jose": "^6.1.3",
    "mammoth": "^1.12.0",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "resend": "^6.17.1",
    "server-only": "^0.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "@playwright/mcp": "^0.0.53",
    "@playwright/test": "^1.57.0",
    "@types/jest": "^30.0.0",
    "@types/node": "24.10.3",
    "@types/nodemailer": "^7.0.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "10.4.22",
    "dotenv": "^17.2.3",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "jest": "^30.3.0",
    "ngrok": "^5.0.0-beta.2",
    "postcss": "8.5.6",
    "ts-jest": "^29.4.9",
    "tsx": "^4.19.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.50.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "next": {
      "postcss": "8.5.10"
    }
  },
  "scripts": {
    "dev": "next dev",
    "dev:lan": "bash scripts/dev-lan.sh",
    "dev:vercel": "vercel dev",
    "dev:vercel:prod": "vercel dev --prod",
    "dev:tunnel": "next dev & ngrok http 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "tsc --noEmit -p tsconfig.api.json",
    "validate": "npm run lint && npm run typecheck && npm run typecheck:api && npm run test:unit && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:parallel": "playwright test --workers=50%",
    "test:e2e:clean": "tsx scripts/clean-remote-test-data.ts && playwright test",
    "test:e2e:sequential": "playwright test tests/e2e/specs/auth.spec.ts tests/e2e/specs/security.spec.ts tests/e2e/specs/file-upload-security.spec.ts tests/e2e/specs/happy-path.spec.ts tests/e2e/specs/destructive.spec.ts",
    "test:e2e:core": "playwright test tests/e2e/specs/happy-path.spec.ts tests/e2e/specs/destructive.spec.ts",
    "test:unit": "jest",
    "test:unit:watch": "jest --watch",
    "test:auth": "playwright test tests/e2e/specs/auth.spec.ts",
    "test:security": "playwright test tests/e2e/specs/security.spec.ts",
    "test:upload-security": "playwright test tests/e2e/specs/file-upload-security.spec.ts",
    "test:upload-security:manual": "playwright test tests/e2e/specs/file-upload-security.spec.ts --headed",
    "test:happy": "playwright test tests/e2e/specs/happy-path.spec.ts",
    "test:destructive": "playwright test tests/e2e/specs/destructive.spec.ts",
    "test:e2e:edit-info": "playwright test tests/e2e/specs/edit-info.spec.ts",
    "clean:test-data": "tsx scripts/clean-remote-test-data.ts",
    "seed:api": "tsx scripts/seed-via-api.ts"
  }
}
