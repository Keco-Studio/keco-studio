    "test:e2e:create-map-v3": "NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321 NEXT_PUBLIC_SUPABASE_ANON_KEY=e2e-anon playwright test tests/e2e/specs/create-map-v3.spec.ts --workers=1",
