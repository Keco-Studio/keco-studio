{
  "lines": [
    "\u4eba\u7269：\u8def\u4eba（\u6797\u91ce）、\u5b66\u751f（\u5c0f\u96e8）",
    "\u573a\u666f：\u508d\u665a，\u66b4\u96e8\u7a81\u88ad\u7684\u8857\u8fb9\u516c\u4ea4\u4ead",
    "【\u6797\u91ce\u6ce8\u610f\u5230\u5c0f\u96e8\u7684\u96e8\u4f1e\u635f\u574f】",
    "\u5206\u652f\u4e00：\u4e3b\u52a8\u642d\u8bdd（\u53ef\u5d4c\u5957\u4e8c\u7ea7\u5206\u652f，\u884d\u751f\u4e24\u4e2a\u4e0d\u540c\u7ed3\u5c40）",
    "\u6797\u91ce：\u540c\u5b66，\u662f\u4f1e\u574f\u4e86\u5417？",
    "\u5c0f\u96e8：\u5bf9，\u6211\u88ab\u56f0\u5728\u8fd9\u91cc\u597d\u4e45\u4e86。",
    "\u5d4c\u5957\u5206\u652fA1：\u4e3b\u52a8\u501f\u4f1e → \u7ed3\u5c40\u4e00（\u6696\u5fc3\u540c\u884c）",
    "\u6797\u91ce：\u6211\u9001\u4f60\u56de\u5bb6\u5427。",
    "【\u4e24\u4eba\u6491\u4f1e\u540c\u884c】",
    "\u5d4c\u5957\u5206\u652fA2：\u6e29\u67d4\u5bbd\u6170 → \u7ed3\u5c40\u4e8c（\u5584\u610f\u7559\u767d）",
    "\u6797\u91ce：\u5148\u5b89\u5fc3\u5728\u4ead\u91cc\u8eb2\u96e8。",
    "【\u6797\u91ce\u4e58\u8f66\u79bb\u5f00】",
    "\u5206\u652f\u4e8c：\u6c89\u9ed8\u65c1\u89c2 → \u7ed3\u5c40\u4e09（\u64e6\u80a9\u964c\u8def）",
    "【\u6797\u91ce\u6ca1\u6709\u51fa\u58f0\u6253\u6270】",
    "\u5c0f\u96e8：\u5230\u5e95\u8be5\u600e\u4e48\u56de\u5bb6\u554a……",
    ""
  ]
}
