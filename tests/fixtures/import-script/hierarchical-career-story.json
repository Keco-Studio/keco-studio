{
  "lines": [
    "\u4eba\u7269：\u6797\u6653、\u738b\u59e8、\u8d75\u54e5",
    "\u7b2c\u4e00\u5e55：\u6289\u62e9\u4e4b\u591c",
    "\u573a\u666f\u4e00：\u6797\u6653\u5bb6\u5367\u5ba4。\u591c。",
    "\u738b\u59e8：\u542c\u5988\u7684，\u5c31\u9009\u5b8f\u56fe。",
    "\u6797\u6653：（\u6c89\u9ed8）\u6211\u9700\u8981\u505a\u51b3\u5b9a。",
    "【\u5206\u652f\u70b9 A：\u9009\u62e9\u5b8f\u56fe\u8d44\u672c，\u6311\u6218\u7ec8\u9762。】（\u8f6c\u7b2c\u4e8c\u5e55）",
    "\u7b2c\u4e8c\u5e55（\u5206\u652f A）：\u5b8f\u56fe\u4e4b\u5dc5",
    "\u5f20\u603b：\u5b8f\u56fe\u9700\u8981\u7684\u662f\u72fc。",
    "【\u7ed3\u5c40 1 - \u6298\u621f\u6c89\u6c99】",
    "（\u6797\u6653\u77e5\u9053\u81ea\u5df1\u641e\u7838\u4e86。）",
    "【\u5206\u652f\u70b9 B：\u9009\u62e9\u542f\u822a\u54a8\u8be2，\u63a5\u53d7\u5f55\u7528。】（\u8f6c\u7b2c\u4e09\u5e55）",
    "\u7b2c\u4e09\u5e55（\u5206\u652f B）：\u5b89\u9038\u4e4b\u59cb",
    "\u8d75\u54e5：\u9009\u6211\u4eec\u51c6\u6ca1\u9519。",
    "【\u5206\u652f\u70b9 B1：\u63a5\u53d7“\u5feb\u901f\u664b\u5347”\u9879\u76ee。】（\u8f6c\u7b2c\u56db\u5e55）",
    "\u7b2c\u56db\u5e55（\u5206\u652f B1）：\u9500\u552e\u6377\u5f84",
    "\u6797\u6653：\u6211\u656c\u60a8。",
    "\u7ed3\u5c40 2 - \u8ff7\u5931\u7684\u7cbe\u82f1",
    "（\u5979\u518d\u4e5f\u627e\u4e0d\u56de\u773c\u91cc\u6709\u5149\u7684\u81ea\u5df1。）",
    "【\u5206\u652f\u70b9 B2：\u9009\u62e9\u7a33\u5065\u7684“\u884c\u4e1a\u7814\u7a76”\u5c97\u4f4d。】（\u8f6c\u7b2c\u4e94\u5e55）",
    "\u7b2c\u4e94\u5e55（\u5206\u652f B2）：\u7814\u62a5\u8ff7\u5bab",
    "\u4e3b\u7ba1：\u4f60\u5f97\u52a0\u70b9\u6545\u4e8b\u6027。",
    "【\u5206\u652f\u70b9 B2a：\u575a\u6301\u4e13\u4e1a\u64cd\u5b88，\u62d2\u7edd“\u6ce8\u6c34”。】（\u8f6c\u7b2c\u516d\u5e55）",
    "\u7b2c\u516d\u5e55（\u5206\u652f B2a）：\u575a\u5b88\u7684\u4ee3\u4ef7",
    "\u6797\u6653：\u6211\u4eec\u4e0d\u80fd\u523b\u610f\u626d\u66f2\u4e8b\u5b9e。",
    "\u7ed3\u5c40 3 - \u5b64\u72ec\u7684\u6e05\u767d\u8005",
    "（\u5979\u6210\u4e86\u575a\u5b9a\u7684\u5e02\u573a\u5b88\u95e8\u4eba。）",
    "【\u5206\u652f\u70b9 B2b：\u987a\u5e94\u516c\u53f8\u6587\u5316，\u5b66\u4f1a“\u5305\u88c5”。】（\u8f6c\u7b2c\u4e03\u5e55）",
    "\u7b2c\u4e03\u5e55（\u5206\u652f B2b）：\u6210\u529f\u7684\u5305\u88c5",
    "\u6797\u6653：\u5408\u4f5c\u6109\u5feb。",
    "\u7ed3\u5c40 4 - \u865a\u4f2a\u7684\u4e13\u5bb6",
    "（\u5979\u6210\u529f\u5305\u88c5\u4e86\u81ea\u5df1。）",
    "\u7b2c\u516b\u5e55：\u6b8a\u9014\u540c\u5f52？（\u5206\u652f\u6c47\u603b）",
    "\u65c1\u767d：\u6797\u6653\u7684\u6545\u4e8b\u6709\u4e86\u4e0d\u540c\u7684\u7ed3\u5c40。",
    "（\u5267\u7ec8）",
    ""
  ]
}
