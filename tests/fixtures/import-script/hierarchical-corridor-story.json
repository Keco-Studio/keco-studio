{
  "lines": [
    "\u4eba\u7269：\u6797\u9ed8、\u82cf\u665a、\u9648\u6559\u6388",
    "【\u8003\u53e4\u7814\u7a76\u6240\u529e\u516c\u5ba4，\u591c\u665a】",
    "\u82cf\u665a：\u6797\u9ed8，\u6211\u4eec\u5fc5\u987b\u518d\u53bb\u4e00\u6b21\u90a3\u4e2a\u5bc6\u5ba4。",
    "\u5206\u652f\u70b9 A：\u7406\u6027\u5224\u65ad",
    "\u6797\u9ed8：\u4e0d\u884c，\u6211\u9700\u8981\u5148\u8054\u7cfb\u5730\u8d28\u52d8\u6d4b\u961f。",
    "→ \u7ed3\u5c40\u4e00：\u9519\u5931\u4e4b\u95e8（\u4e09\u5929\u540e\u5165\u53e3\u88ab\u5c01\u6b7b。）",
    "\u5206\u652f\u70b9 B：\u76f4\u89c9\u5148\u884c",
    "\u6797\u9ed8：\u597d\u5427，\u4f46\u51fa\u73b0\u5f02\u5e38\u5c31\u7acb\u523b\u64a4\u9000。",
    "\u82cf\u665a：\u6210\u4ea4。",
    "\u9648\u6559\u6388（\u58f0）：\u6797\u9ed8，\u522b\u78b0\u90a3\u9762\u9ed1\u8272\u7684\u955c\u5b50。",
    "\u5206\u652f\u70b9 A1：\u89e6\u78b0\u9ed1\u955c",
    "\u6797\u9ed8：\u6211\u5230\u4e86\u6765\u8def？",
    "→ \u7ed3\u5c40\u4e8c：\u6c38\u6052\u6d41\u653e（\u6797\u9ed8\u7559\u5728\u65f6\u95f4\u5939\u7f1d\u4e2d。）",
    "\u5206\u652f\u70b9 A2：\u7ed5\u884c\u9ed1\u955c",
    "\u82cf\u665a：\u90a3\u91cc\u6709\u4e00\u9762\u6b63\u5e38\u7684\u94dc\u955c。",
    "\u6797\u9ed8：\u6b63\u786e\u7684\u8def\u662f\u7ed5\u5f00\u4e0d\u5bfb\u5e38\u7684\u955c\u5b50。",
    "\u82cf\u665a：\u65e5\u8bb0\u91cc\u7684\u98ce\u548c\u706b\u987a\u5e8f\u76f8\u53cd。",
    "→ \u5206\u652f B1：\u4fe1\u4efb\u65e5\u8bb0，\u6309\u539f\u5e8f\u5f00\u95e8",
    "\u6797\u9ed8：\u7ee7\u7eed\u8d70\u5b8c\u6700\u540e\u4e00\u9053\u95e8。",
    "*→ \u7ed3\u5c40\u4e09：\u5f52\u9014\u4e0e\u4ee3\u4ef7（\u4e24\u4eba\u56de\u5230\u9632\u7a7a\u6d1e。）",
    "\u5206\u652f B2：\u6000\u7591\u65e5\u8bb0，\u6309\u8865\u6ce8\u987a\u5e8f\u8c03\u6574",
    "\u82cf\u665a：\u8fd9\u662f\u5b8c\u6574\u7684\u56de\u5eca\u5efa\u9020\u8bb0\u5f55。",
    "*→ \u7ed3\u5c40\u56db：\u85aa\u706b\u76f8\u4f20（\u4ed6\u4eec\u4e0e\u9648\u6559\u6388\u6c47\u5408。）",
    "（\u5168\u5267\u7ec8。\u706f\u5149\u6536\u6697。）",
    ""
  ]
}
