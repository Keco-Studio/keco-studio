{
  "lines": [
    "\u4eba\u7269",
    "\u82cf\u79be（\u5973，26\u5c81）：\u65e7\u4e66\u5e97\u5e97\u4e3b，\u5b89\u9759\u6e29\u67d4，\u5fc3\u601d\u901a\u900f",
    "\u6c5f\u5c7f（\u7537，23\u5c81）：\u5e94\u5c4a\u6bd5\u4e1a\u751f，\u7ea0\u7ed3\u8ff7\u832b，\u6df1\u9677\u9009\u62e9\u5185\u8017",
    "\u573a\u666f：\u6df1\u591c\u5341\u70b9，\u8001\u8857\u5c0f\u4f17\u65e7\u4e66\u5e97，\u6728\u8d28\u4e66\u67b6\u6797\u7acb，\u6696\u9ec4\u53f0\u706f\u5fae\u5149，\u7a97\u5916\u665a\u98ce\u5fae\u51c9，\u5e97\u5185\u5b89\u9759\u9759\u8c27",
    "",
    "【\u5f00\u7bc7\u56fa\u5b9a\u5267\u60c5】",
    "（\u6df1\u591c\u8001\u8857\u884c\u4eba\u7a00\u5c11，\u6c5f\u5c7f\u63a8\u95e8\u800c\u5165，\u98ce\u94c3\u8f7b\u54cd。\u4ed6\u6b65\u5c65\u8fdf\u7591，\u76ee\u5149\u614c\u4e71\u5730\u626b\u8fc7\u6ee1\u67b6\u65e7\u4e66，\u53cc\u624b\u4e0d\u81ea\u89c9\u6512\u7740\u4e66\u5305\u5e26，\u795e\u8272\u7126\u707c\u53c8\u75b2\u60eb）",
    "\u82cf\u79be：（\u653e\u4e0b\u624b\u4e2d\u6574\u7406\u7684\u4e66\u7c4d，\u8f7b\u58f0\u5f00\u53e3）\u665a\u4e0a\u597d，\u968f\u4fbf\u901b\u5c31\u53ef\u4ee5，\u4e0d\u7528\u62d8\u675f。",
    "（\u6c5f\u5c7f\u6ca1\u6709\u5e94\u58f0，\u6162\u6162\u8d70\u5230\u4e66\u67b6\u65c1，\u6307\u5c16\u5212\u8fc7\u4e66\u810a，\u5374\u6ca1\u6709\u7ffb\u770b\u4efb\u4f55\u4e00\u672c\u4e66，\u5168\u7a0b\u795e\u8272\u90c1\u90c1）",
    "\u82cf\u79be：\u8fd9\u4e48\u665a\u8fc7\u6765，\u662f\u60f3\u627e\u4e66，\u8fd8\u662f\u60f3\u8eb2\u4e00\u4f1a\u513f？",
    "\u6c5f\u5c7f：（\u8fdf\u7591\u51e0\u79d2，\u8bed\u6c14\u6c89\u95f7）……\u968f\u4fbf\u770b\u770b，\u5c31\u662f\u5fc3\u91cc\u4e71，\u4e0d\u77e5\u9053\u8be5\u53bb\u54ea。",
    "【\u7b2c\u4e00\u5c42\u7ea7\u53cc\u5e76\u884c\u5206\u652f（\u4e0d\u540c\u9009\u62e9，\u6c47\u5165\u540c\u4e00\u4e2d\u6bb5\u5267\u60c5）】",
    "\u5206\u652fA：\u6e29\u548c\u4e3b\u52a8\u95ee\u8be2",
    "\u82cf\u79be：\u6211\u770b\u4f60\u7709\u5934\u4e00\u76f4\u76b1\u7740，\u50cf\u662f\u6709\u89e3\u4e0d\u5f00\u7684\u70e6\u5fc3\u4e8b。\u6df1\u591c\u7684\u4e66\u5e97\u5f88\u5b89\u9759，\u4e0d\u60f3\u8bf4\u8bdd\u4e5f\u6ca1\u5173\u7cfb，\u53ef\u4ee5\u6162\u6162\u5f85\u4e00\u4f1a\u513f。",
    "\u6c5f\u5c7f：（\u5fae\u5fae\u5782\u7738，\u8bed\u6c14\u65e0\u5948）\u8c22\u8c22\u5e97\u4e3b，\u6211\u5c31\u662f……\u4e0d\u77e5\u9053\u81ea\u5df1\u7684\u9009\u62e9\u5230\u5e95\u5bf9\u4e0d\u5bf9。",
    "\u5206\u652fB：\u5b89\u9759\u7559\u767d\u966a\u4f34",
    "\u82cf\u79be：\u5f88\u591a\u4eba\u5fc3\u60c5\u4e0d\u597d\u7684\u65f6\u5019，\u90fd\u4f1a\u6765\u8fd9\u5bb6\u65e7\u4e66\u5e97\u5750\u5750。\u4e66\u672c\u6700\u80fd\u9759\u5fc3，\u8981\u662f\u5fc3\u70e6，\u4e0d\u59a8\u6162\u6162\u7ffb\u4e24\u672c，\u4e0d\u7528\u6025\u7740\u505a\u51b3\u5b9a。",
    "\u6c5f\u5c7f：（\u8f7b\u8f7b\u53f9\u6c14，\u5378\u4e0b\u4e9b\u8bb8\u9632\u5907）\u6211\u4e0d\u662f\u4e0d\u60f3\u51b3\u5b9a，\u662f\u592a\u5bb3\u6015\u9009\u9519\u4e86。",
    "【\u5e76\u884c\u5206\u652f\u7edf\u4e00\u6c47\u5165：\u4e2d\u6bb5\u56fa\u5b9a\u5267\u60c5】",
    "（\u6c5f\u5c7f\u8f6c\u8eab\u9760\u5728\u4e66\u67b6\u65c1，\u5378\u4e0b\u6240\u6709\u7d27\u7ef7\u59ff\u6001，\u773c\u5e95\u6ee1\u662f\u8ff7\u832b。\u6bd5\u4e1a\u5728\u5373，\u4ed6\u5361\u5728\u4eba\u751f\u5173\u952e\u8def\u53e3，\u8fdf\u8fdf\u65e0\u6cd5\u4e0b\u5b9a\u51b3\u5fc3）",
    "\u82cf\u79be：\u662f\u6bd5\u4e1a\u7684\u96be\u9898\u5417？\u8003\u7814、\u5de5\u4f5c、\u5f02\u5730，\u5927\u591a\u4eba\u7684\u8ff7\u832b，\u90fd\u5361\u5728\u8fd9\u51e0\u4e2a\u9009\u62e9\u91cc。",
    "\u6c5f\u5c7f：（\u7528\u529b\u70b9\u5934，\u8bed\u6c14\u6ee1\u662f\u5185\u8017）\u6211\u62ff\u5230\u4e86\u5c0f\u57ce\u5e02\u5b89\u7a33\u5de5\u4f5c\u7684offer，\u5bb6\u4eba\u90fd\u8ba9\u6211\u7559\u4e0b\u6765。\u4f46\u6211\u53c8\u4e0d\u7518\u5fc3，\u60f3\u53bb\u5927\u57ce\u5e02\u95ef\u8361，\u53ef\u53c8\u6015\u78b0\u58c1、\u6015\u5931\u8d25，\u6015\u81ea\u5df1\u52aa\u529b\u4e00\u573a\u4e00\u65e0\u6240\u6709，\u6bcf\u5929\u90fd\u5728\u53cd\u590d\u7ea0\u7ed3、\u81ea\u6211\u6d88\u8017。",
    "【\u7b2c\u4e8c\u5c42\u7ea7\u5d4c\u5957\u5206\u652f（\u4e00\u7ea7\u9009\u62e9+\u4e8c\u7ea7\u5d4c\u5957\u9009\u62e9，\u5c42\u5c42\u9012\u8fdb）】",
    "\u4e00\u7ea7\u9009\u62e91：\u7406\u6027\u5256\u6790\u5229\u5f0a（\u89e6\u53d1\u4e8c\u7ea7\u5d4c\u5957\u5206\u652f）",
    "\u82cf\u79be：\u4eba\u751f\u6ca1\u6709\u7edd\u5bf9\u6b63\u786e\u7684\u9009\u62e9，\u53ea\u6709\u9002\u5408\u81ea\u5df1\u7684\u8def。\u5b89\u7a33\u6709\u5b89\u7a33\u7684\u5e73\u6de1，\u95ef\u8361\u6709\u95ef\u8361\u7684\u6210\u957f，\u4e0d\u7528\u8fc7\u5ea6\u7ea0\u7ed3\u5bf9\u9519。",
    "\u6c5f\u5c7f：（\u6447\u5934\u82e6\u7b11）\u53ef\u6211\u5c31\u662f\u6015\u9057\u61be，\u9009\u4e86\u5b89\u7a33，\u4f1a\u4e0d\u7518\u5e73\u5eb8；\u9009\u4e86\u95ef\u8361，\u53c8\u6015\u65e5\u540e\u8f9b\u82e6\u540e\u6094。",
    "\u4e8c\u7ea7\u5d4c\u5957\u5206\u652f1-1：\u53d6\u820d\u5f00\u5bfc",
    "\u82cf\u79be：\u9057\u61be\u662f\u4eba\u751f\u5e38\u6001，\u6ca1\u6709\u54ea\u6761\u8def\u80fd\u5341\u5168\u5341\u7f8e。\u6bd4\u8d77\u5bb3\u6015\u672a\u6765\u672a\u77e5\u7684\u98ce\u9669，\u66f4\u91cd\u8981\u7684\u662f\u95ee\u95ee\u81ea\u5df1，\u4f60\u771f\u6b63\u60f3\u8981\u7684\u751f\u6d3b\u662f\u4ec0\u4e48\u6837\u5b50。",
    "\u6c5f\u5c7f：（\u773c\u795e\u677e\u52a8）\u6211……\u5176\u5b9e\u66f4\u60f3\u8d81\u5e74\u8f7b\u62fc\u4e00\u6b21。",
    "\u4e8c\u7ea7\u5d4c\u5957\u5206\u652f1-2：\u843d\u5730\u529d\u89e3",
    "\u82cf\u79be：\u72b9\u8c6b\u7684\u672c\u8d28，\u662f\u4f60\u65e2\u60f3\u8981\u5b89\u7a33\u7684\u515c\u5e95，\u53c8\u60f3\u8981\u8ffd\u68a6\u7684\u81ea\u7531。\u4e16\u95f4\u672c\u65e0\u4e24\u5168\u4e4b\u7b56，\u5e74\u8f7b\u6700\u5927\u7684\u5e95\u6c14，\u5c31\u662f\u53ef\u4ee5\u8bd5\u9519。",
    "\u6c5f\u5c7f：（\u4f4e\u58f0\u5462\u5583）\u8bd5\u9519\u7684\u4ee3\u4ef7，\u6211\u771f\u7684\u80fd\u627f\u62c5\u5417？",
    "\u4e00\u7ea7\u9009\u62e92：\u5171\u60c5\u6cbb\u6108\u5b89\u629a（\u89e6\u53d1\u4e8c\u7ea7\u5d4c\u5957\u5206\u652f）",
    "\u82cf\u79be：\u6211\u7279\u522b\u61c2\u8fd9\u79cd\u611f\u53d7，\u7ad9\u5728\u5206\u5c94\u8def\u53e3，\u5de6\u53f3\u4e3a\u96be，\u6015\u4e00\u6b65\u9519\u6b65\u6b65\u9519，\u6240\u4ee5\u8fdf\u8fdf\u4e0d\u6562\u8fc8\u6b65，\u4e0d\u65ad\u5185\u8017\u6298\u78e8\u81ea\u5df1。",
    "\u6c5f\u5c7f：（\u773c\u5e95\u6cdb\u8d77\u6696\u610f）\u539f\u6765\u6709\u4eba\u80fd\u61c2\u8fd9\u79cd\u714e\u71ac，\u8eab\u8fb9\u4eba\u90fd\u53ea\u8ba9\u6211\u9009\u5b89\u7a33\u7684\u8def，\u4ece\u6765\u6ca1\u4eba\u95ee\u8fc7\u6211\u60f3\u4e0d\u60f3。",
    "\u4e8c\u7ea7\u5d4c\u5957\u5206\u652f2-1：\u6e29\u67d4\u5171\u60c5\u5bbd\u6170",
    "\u82cf\u79be：\u5927\u5bb6\u90fd\u559c\u6b22\u7a33\u59a5\u7684\u7ed3\u679c，\u5374\u5ffd\u7565\u4e86\u5fc3\u91cc\u7684\u70ed\u7231\u6700\u96be\u5f97。\u4f60\u7ea0\u7ed3\u7684\u4e0d\u662f\u5bf9\u9519，\u662f\u4e0d\u7518\u5fc3\u653e\u5f03\u81ea\u5df1\u7684\u521d\u5fc3。",
    "\u6c5f\u5c7f：（\u8f7b\u8f7b\u70b9\u5934）\u5bf9，\u6211\u4e0d\u60f3\u5e74\u7eaa\u8f7b\u8f7b\u5c31\u88ab\u56f0\u5728\u4e00\u6210\u4e0d\u53d8\u7684\u751f\u6d3b\u91cc。",
    "\u4e8c\u7ea7\u5d4c\u5957\u5206\u652f2-2：\u6e29\u67d4\u515c\u5e95\u529d\u89e3",
    "\u82cf\u79be：\u4eba\u751f\u4e0d\u7528\u4e00\u6b21\u9009\u5230\u6ee1\u5206。\u5c31\u7b97\u53bb\u5927\u57ce\u5e02\u78b0\u58c1\u4e86，\u8fd9\u6bb5\u7ecf\u5386\u4e5f\u662f\u4f60\u7684\u5e95\u6c14，\u4ece\u6765\u90fd\u4e0d\u7b97\u767d\u8d39。",
    "\u6c5f\u5c7f：（\u8c41\u7136\u5f00\u6717）\u597d\u50cf\u662f\u554a，\u7ecf\u5386\u672c\u8eab\u5c31\u662f\u4e00\u79cd\u6536\u83b7。",
    "【\u6240\u6709\u5d4c\u5957\u5206\u652f\u7edf\u4e00\u6c47\u805a：\u6700\u7ec8\u56fa\u5b9a\u7ed3\u5c40】",
    "（\u6696\u9ec4\u53f0\u706f\u7f13\u7f13\u7167\u4eae\u4e24\u4eba\u8eab\u5f71，\u7a97\u5916\u665a\u98ce\u6e29\u67d4\u5439\u6563\u71e5\u70ed，\u6240\u6709\u7ea0\u7ed3、\u5185\u8017\u7684\u60c5\u7eea\u6162\u6162\u6d88\u6563。\u65e0\u8bba\u6b64\u524d\u9009\u62e9\u54ea\u4e00\u6761\u5bf9\u8bdd\u5206\u652f，\u6c5f\u5c7f\u6700\u7ec8\u90fd\u89e3\u5f00\u5185\u5fc3\u67b7\u9501）",
    "\u82cf\u79be：\u5176\u5b9e\u771f\u6b63\u7684\u9057\u61be，\u4ece\u6765\u4e0d\u662f\u9009\u9519\u8def，\u800c\u662f\u660e\u660e\u6709\u673a\u4f1a，\u5374\u4e0d\u6562\u52c7\u6562\u5c1d\u8bd5。\u5b89\u7a33\u53ef\u4ee5\u968f\u65f6\u62e5\u6709，\u4f46\u5e74\u5c11\u7684\u52c7\u6c14\u548c\u70ed\u5ff1，\u9519\u8fc7\u5c31\u5f88\u96be\u518d\u6709。",
    "\u6c5f\u5c7f：（\u7709\u773c\u8212\u5c55，\u892a\u53bb\u6240\u6709\u7126\u8651，\u8bed\u6c14\u575a\u5b9a）\u6211\u60f3\u660e\u767d\u4e86。\u6211\u6253\u7b97\u63a5\u53d7\u5927\u57ce\u5e02\u7684\u9762\u8bd5\u9080\u8bf7，\u8d81\u7740\u5e74\u8f7b\u53bb\u95ef\u4e00\u95ef。\u5c31\u7b97\u8f9b\u82e6\u4e00\u70b9、\u9047\u5230\u632b\u6298\u4e5f\u6ca1\u5173\u7cfb，\u81f3\u5c11\u4e0d\u4f1a\u7559\u4e0b\u9057\u61be。",
    "\u82cf\u79be：（\u6de1\u6de1\u6d45\u7b11，\u6e29\u67d4\u70b9\u5934）\u8fd9\u5c31\u591f\u4e86。\u9075\u4ece\u672c\u5fc3\u7684\u9009\u62e9，\u5c31\u662f\u6700\u597d\u7684\u9009\u62e9。\u4e0d\u5fc5\u7126\u8651\u672a\u6765，\u811a\u8e0f\u5b9e\u5730\u5f80\u524d\u8d70，\u4e00\u5207\u90fd\u4f1a\u6162\u6162\u53d8\u597d。",
    "\u6c5f\u5c7f：（\u7531\u8877\u9053\u8c22）\u771f\u7684\u592a\u8c22\u8c22\u4f60\u4e86。\u4eca\u665a\u5982\u679c\u6ca1\u6765\u8fd9\u91cc，\u6211\u5927\u6982\u8fd8\u8981\u7ea0\u7ed3\u4e00\u6574\u665a，\u4e00\u76f4\u9677\u5165\u81ea\u6211\u5185\u8017。",
    "\u82cf\u79be：\u4e0d\u7528\u5ba2\u6c14。\u4e66\u5e97\u6536\u7559\u6bcf\u4e00\u4e2a\u8ff7\u832b\u7684\u4eba，\u4e5f\u89c1\u8bc1\u6bcf\u4e00\u6b21\u548c\u89e3\u4e0e\u6210\u957f。",
    "（\u6c5f\u5c7f\u633a\u76f4\u810a\u80cc，\u773c\u5e95\u91cd\u62fe\u5149\u4eae，\u8138\u4e0a\u892a\u53bb\u9634\u90c1，\u591a\u4e86\u51e0\u5206\u7b03\u5b9a\u4e0e\u5766\u7136。\u665a\u98ce\u7a7f\u7a97\u800c\u8fc7，\u5439\u52a8\u4e66\u9875\u8f7b\u54cd，\u9759\u8c27\u7684\u4e66\u5e97\u91cc\u6ee1\u662f\u6e29\u67d4\u4e0e\u5e0c\u671b，\u5168\u5267\u6536\u5c3e\u7edf\u4e00\u95ed\u73af）",
    "（\u5267\u7ec8）",
    ""
  ]
}
