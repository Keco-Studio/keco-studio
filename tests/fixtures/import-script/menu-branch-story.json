{
  "lines": [
    "\u573a\u666f\u4e00：\u57ce\u5e02\u5e7f\u573a - \u65e5 - \u5916",
    "\u4eba\u7269：\u6797\u6d69（28\u5c81，\u5386\u53f2\u5b66\u8005），\u9648\u6559\u6388（60\u5c81，\u8003\u53e4\u5b66\u5bb6）",
    "\u9648\u6559\u6388：\u771f\u76f8\u5728\u949f\u697c\u9876\u7aef。",
    "\u6797\u6d69：\u54e8\u58f0？\u4ec0\u4e48\u54e8\u58f0？",
    "【\u9009\u9879\u51fa\u73b0】",
    "* A：\u7acb\u523b\u524d\u5f80\u949f\u697c",
    "* B：\u5148\u67e5\u9605\u66f4\u591a\u5386\u53f2\u6863\u6848",
    "* C：\u8be2\u95ee\u9648\u6559\u6388\u66f4\u591a\u7ec6\u8282",
    "***",
    "【\u9009\u62e9A - \u7acb\u523b\u524d\u5f80\u949f\u697c】",
    "\u6797\u6d69\u51b2\u5411\u949f\u697c。",
    "【\u7ed3\u5c40A：\u82f1\u96c4\u7684\u6c89\u9ed8】",
    "\u9648\u6559\u6388：\u4ed6\u4eec\u7528\u751f\u547d\u5b88\u4f4f\u4e86\u771f\u76f8。",
    "***",
    "【\u9009\u62e9B - \u5148\u67e5\u9605\u66f4\u591a\u5386\u53f2\u6863\u6848】",
    "\u6797\u6d69\u6ce1\u5728\u6863\u6848\u9986\u4e09\u5929。",
    "【\u5206\u652f：\u5f55\u97f3\u5e26\u5185\u5bb9\u5f15\u53d1\u65b0\u7ebf\u7d22】",
    "【\u7ed3\u5c40B：\u58f0\u97f3\u7684\u4ee3\u4ef7】",
    "\u6797\u6d69\u5c06\u54e8\u5b50\u653e\u5728\u7eaa\u5ff5\u7891\u524d。",
    "***",
    "【\u9009\u62e9C - \u8be2\u95ee\u9648\u6559\u6388\u66f4\u591a\u7ec6\u8282】",
    "\u9648\u6559\u6388：\u4ed6\u4eec\u662f\u88ab\u7559\u4e0b\u7684。",
    "【\u5206\u652f：\u4e3a\u4ec0\u4e48\u88ab\u7559\u4e0b？】",
    "【\u7ed3\u5c40C：\u65e0\u540d\u7684\u5fe0\u8bda】",
    "\u6797\u6d69：\u4f60\u4eec\u4ece\u672a\u53db\u53d8。",
    "***",
    "【\u6700\u7ec8\u5c3e\u58f0 - \u6240\u6709\u5206\u652f\u6c47\u805a】",
    "\u6797\u6d69：\u73b0\u5728，\u6211\u4eec\u542c\u5230\u4e86。",
    "【\u9ed1\u5c4f】",
    "\u5b57\u5e55：\u8c28\u4ee5\u6b64\u7247\u732e\u7ed9\u6240\u6709\u672a\u88ab\u8bb0\u8f7d\u7684\u5fe0\u8bda。",
    ""
  ]
