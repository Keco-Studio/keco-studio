{
  "lines": [
    "\u4eba\u7269：\u674e\u660e、\u738b\u59d0、\u5f20\u5de5",
    "\u573a\u666f：\u73b0\u4ee3\u4f1a\u8bae\u5ba4。",
    "（\u706f\u5149\u4eae\u8d77。\u674e\u660e\u6525\u7740\u7b80\u5386。）",
    "\u5f20\u5de5：\u4f60\u9047\u5230\u7684\u6700\u5927\u6311\u6218\u662f\u4ec0\u4e48？",
    "（\u6838\u5fc3\u5206\u652f\u70b9A：\u6280\u672f\u95ee\u9898\u56de\u7b54）",
    "\u674e\u660e：\u6700\u5927\u7684\u6311\u6218\u662f\u6570\u636e\u4e00\u81f4\u6027。",
    "\u5f20\u5de5：\u4f60\u4eec\u600e\u4e48\u89e3\u51b3\u7684？",
    "（\u5b50\u5206\u652f\u70b9A1：\u6280\u672f\u6df1\u5ea6\u56de\u7b54）",
    "\u674e\u660e：\u6211\u4eec\u9009\u62e9\u4e86Saga\u6a21\u5f0f。",
    "（\u5d4c\u5957\u5b50\u5206\u652f\u70b9A1a：\u65b9\u6848\u5bf9\u6bd4）",
    "\u5f20\u5de5：\u8fd9\u4e2a\u65b9\u6848\u53ef\u4ee5。",
    "（\u8f6c\u5411\u5b50\u5206\u652f\u70b9A2：\u6280\u672f\u74f6\u9888\u56de\u7b54。\u5982\u679c\u56de\u7b54\u8fc7\u4e8e\u7b3c\u7edf。）",
    "（\u95ea\u56de/\u5047\u8bbe\u573a\u666f：\u5982\u679c\u674e\u660e\u8fd9\u6837\u56de\u7b54……）",
    "\u674e\u660e：\u597d\u50cf\u6ca1\u4ec0\u4e48\u6311\u6218。",
    "\u5f20\u5de5：\u6211\u5927\u6982\u4e86\u89e3\u4e86。",
    "（\u6b64\u5206\u652f\u901a\u5411\u7ed3\u5c403：\u6280\u672f\u80fd\u529b\u5b58\u7591。）",
    "（\u56de\u5230\u4e3b\u7ebf：\u6280\u672f\u56de\u7b54\u7ed3\u675f。）",
    "（\u6838\u5fc3\u5206\u652f\u70b9B：\u79bb\u804c\u539f\u56e0\u56de\u7b54）",
    "\u738b\u59d0：\u4f60\u662f\u4e3b\u52a8\u8d70\u7684，\u8fd8\u662f\u88ab\u88c1\u5458？",
    "（\u5b50\u5206\u652f\u70b9B1：\u8bda\u5b9e\u56de\u7b54）",
    "\u674e\u660e：\u6211\u4eec\u7ec4\u88ab\u4f18\u5316\u4e86。",
    "（\u5d4c\u5957\u5b50\u5206\u652f\u70b9B1a：\u53cd\u601d\u590d\u76d8）",
    "\u738b\u59d0：\u80fd\u5766\u8bda\u8bf4\u51fa\u6765，\u5f88\u597d。",
    "（\u8f6c\u5411\u5b50\u5206\u652f\u70b9B2：\u5982\u679c\u674e\u660e\u8c0e\u79f0\u4e3b\u52a8\u8f9e\u804c。）",
    "\u674e\u660e：\u6211\u662f\u4e3b\u52a8\u8f9e\u804c\u7684。",
    "\u738b\u59d0：\u4f60\u7684\u8d1f\u9762\u60c5\u7eea\u5f88\u660e\u663e。",
    "（\u6b64\u5206\u652f\u901a\u5411\u7ed3\u5c402：\u63a8\u5378\u8d23\u4efb。）",
    "（\u4e3b\u7ebf：\u79bb\u804c\u539f\u56e0\u56de\u7b54\u7ed3\u675f。）",
    "（\u6838\u5fc3\u5206\u652f\u70b9C：\u85aa\u8d44\u8c08\u5224）",
    "\u738b\u59d0：\u53ea\u80fd\u7ed9\u4e24\u4e07，\u4f60\u8fd8\u8003\u8651\u5417？",
    "\u674e\u660e：\u548c\u6211\u7684\u671f\u671b\u6709\u5dee\u8ddd。",
    "（\u5b50\u5206\u652f\u70b9C1：\u575a\u6301\u5e95\u7ebf）",
    "\u674e\u660e：\u6211\u613f\u610f\u5c55\u793a\u5f39\u6027\u548c\u4ef7\u503c。",
    "（\u5d4c\u5957\u5b50\u5206\u652f\u70b9C1a：\u5c55\u793a\u5f39\u6027\u4e0e\u4ef7\u503c）",
    "\u738b\u59d0：\u6211\u4eec\u4f1a\u8ba4\u771f\u8003\u8651。",
    "（\u6b64\u5206\u652f\u901a\u5411\u7ed3\u5c401：\u6210\u529f\u5f55\u7528。）",
    "（\u8f6c\u5411\u5b50\u5206\u652f\u70b9C2：\u5982\u679c\u674e\u660e\u7acb\u523b\u59a5\u534f。）",
    "\u674e\u660e：\u4e24\u4e07\u4e5f\u884c。",
    "（\u6b64\u5206\u652f\u901a\u5411\u7ed3\u5c404：\u8fdb\u5165\u5907\u9009\u6c60。）",
    "（\u8f6c\u5411\u5b50\u5206\u652f\u70b9C3：\u5982\u679c\u674e\u660e\u5f3a\u786c\u62d2\u7edd。）",
    "\u674e\u660e：\u4f4e\u4e8e\u5e95\u7ebf\u4e0d\u80fd\u63a5\u53d7。",
    "（\u6b64\u5206\u652f\u901a\u5411\u7ed3\u5c405：\u8c08\u5224\u7834\u88c2。）",
    "（\u706f\u5149\u53d8\u6697，\u4e09\u4eba\u63e1\u624b。）",
    "\u7ed3\u5c401：\u5f55\u7528\u901a\u77e5。",
    "\u7ed3\u5c402：\u6c38\u4e0d\u5f55\u7528。",
    "\u7ed3\u5c403：\u6280\u672f\u590d\u76d8。",
    "\u7ed3\u5c404：\u5907\u9009\u4eba\u751f。",
    "\u7ed3\u5c405：\u65b0\u7684\u5f00\u59cb。",
    "（\u5267\u7ec8。）",
    ""
  ]
}
